<p style="color: green"><%= notice %></p>

<div class="shadow p-3 rounded-3">
  <h1 class="text-center">
    <%= t(:users)%>
    <a href="<%= new_user_path %>" style="text-decoration: none" class="ms-3">
      <i class="fa-solid fa-circle-plus fa-xs"></i>
    </a>
  </h1>

  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th scope="col"><%= t("ui.username") %></th>
          <th scope="col"><%= t("ui.email") %></th>
          <th scope="col"><%= t(:full_name) %></th>
          <th scope="col"><%= t("ui.role") %></th>
          <th scope="col"><%= t("ui.edit") %></th>
          <th scope="col"><%= t("ui.status") %></th>
        </tr>
      </thead>
      <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= link_to user.user_name, user, class: 'text-reset link-hover' %></td>
          <td><%= link_to user.email, user, class: 'text-reset link-hover' %></td>
          <td><%= link_to user.full_name, user, class: 'text-reset link-hover' %></td>
          <td><%= link_to user.permission_name, user, class: 'text-reset link-hover' %></td>
          <td>
            <a href="<%= edit_user_path(user) %>" class="link-success d-flex justify-content-center link-hover">
              <i class="fa-solid fa-pen-to-square"></i>
            </a>
          </td>
          <td class="text-center">
            <span class="badge <%= user.enabled? ? 'text-bg-success' : 'text-bg-secondary' %> me-2"><%= user.enabled? ? t("ui.enabled") : t("ui.disabled") %></span>
            <% unless user == current_user %>
              <%= button_to enable_change_user_path(user), method: :patch, class: "btn btn-link p-0 #{user.enabled? ? 'link-danger' : 'link-success'}", title: (t(user.enabled? ? "ui.confirm_disable_user" : "ui.confirm_enable_user")), aria: { label: (t(user.enabled? ? "ui.confirm_disable_user" : "ui.confirm_enable_user")) }, form: { data: { turbo_confirm: (user.enabled? ? t("ui.confirm_disable_user") : t("ui.confirm_enable_user")) } } do %>
                <i class="fa-solid <%= user.enabled? ? 'fa-eye-slash' : 'fa-eye' %>" aria-hidden="true"></i>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

  <% if @total_pages > 1 %>
    <nav class="mt-4" aria-label="<%= t('ui.pagination_users') %>">
      <ul class="pagination justify-content-center mb-0">
        <li class="page-item <%= 'disabled' if @current_page == 1 %>">
          <%= link_to t("ui.previous"), users_path(page: @current_page - 1), class: 'page-link', aria: { label: t("ui.previous") } %>
        </li>
        <% (1..@total_pages).each do |page| %>
          <li class="page-item <%= 'active' if page == @current_page %>">
            <%= link_to page, users_path(page: page), class: 'page-link', aria: { current: (page == @current_page ? 'page' : nil) } %>
          </li>
        <% end %>
        <li class="page-item <%= 'disabled' if @current_page == @total_pages %>">
          <%= link_to t("ui.next"), users_path(page: @current_page + 1), class: 'page-link', aria: { label: t("ui.next") } %>
        </li>
      </ul>
    </nav>
  <% end %>

  <%= link_to t(:new_user), new_user_path, class: 'btn btn-primary mt-1' %>
</div>
