<main class="auth-page">
  <section class="auth-card" aria-labelledby="auth-title">
    <div class="auth-card__brand">
      <%= image_tag "fnvb.png", alt: "", class: "auth-card__logo" %>
      <span>Federación Nicaragüense de Voleibol</span>
    </div>

    <div class="auth-card__content">
      <p class="auth-card__eyebrow"><%= t(:log_in) %></p>
      <h1 id="auth-title" class="auth-card__title"><%= t(:log_in) %></h1>
      <p class="auth-card__intro"><%= t("ui.login_intro", default: "Accede a tu cuenta para continuar.") %></p>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
        <div class="mb-3">
          <%= f.label :email, t(:email), class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "nombre@ejemplo.com" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, t(:password), class: "form-label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-check auth-form__remember">
            <%= f.check_box :remember_me, class: "form-check-input" %>
            <%= f.label :remember_me, t(:remember_me), class: "form-check-label" %>
          </div>
        <% end %>

        <%= f.submit t(:log_in), class: "btn btn-primary auth-form__submit" %>
      <% end %>

      <div class="auth-card__links">
        <%= render "users/shared/links" %>
      </div>
    </div>
  </section>
</main>
