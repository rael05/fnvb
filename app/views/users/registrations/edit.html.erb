<h2><%= t("ui.edit_resource", resource: t("ui.resources.user").capitalize) %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "users/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div><%= t("ui.waiting_confirmation", email: resource.unconfirmed_email) %></div>
  <% end %>

  <div class="field">
    <%= f.label :password %> <i><%= t("ui.password_leave_blank") %></i><br />
    <%= f.password_field :password, autocomplete: "new-password" %>
    <% if @minimum_password_length %>
      <br />
      <em><%= t("ui.password_minimum_length", count: @minimum_password_length) %></em>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :current_password %> <i><%= t("ui.current_password_confirmation") %></i><br />
    <%= f.password_field :current_password, autocomplete: "current-password" %>
  </div>

  <div class="actions">
    <%= f.submit t("ui.update") %>
  </div>
<% end %>

<h3><%= t("ui.manage_account") %></h3>

<div class="d-flex align-items-center gap-3">
  <span><%= t("ui.account_disabled_notice") %></span>
  <%= button_to enable_change_user_path(resource), method: :patch, class: "btn btn-outline-danger", form: { data: { turbo_confirm: t("ui.confirm_disable_account") } } do %>
    <i class="fa-solid fa-eye-slash me-2" aria-hidden="true"></i><%= t("ui.disable_account") %>
  <% end %>
</div>

<%= link_to t("ui.back"), :back %>
