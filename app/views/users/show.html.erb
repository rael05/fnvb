<p style="color: green"><%= notice %></p>

<div class="shadow p-3 rounded-3">

  <div id="<%= dom_id @user %>">
    <p>
      <strong><%= t(:user_name) %>:</strong>
      <%= @user.user_name %>
    </p>

    <p>
      <strong><%= t(:email) %>:</strong>
      <%= @user.email %>
    </p>

    <p>
      <strong><%= t(:name) %>:</strong>
      <%= @user.first_name %>
    </p>

    <p>
      <strong><%= t(:last_name) %>:</strong>
      <%= @user.last_name %>
    </p>

    <p>
      <strong><%= t("ui.role") %>:</strong>
      <%= @user.permission_name %>
    </p>

    <% if(@user.isInternacional?) %>
      <p>
        <strong><%= t(:tournament_where_team_is_managed) %>:</strong>
        <% if @user.tournament.nil? %>
          <%= t(:without_tournament) %>
        <% else %>
          <%= @user.tournament.name %>
        <% end %>
      </p>

      <p>
        <strong><%= t("ui.managed_team") %>:</strong>
        <% if @user.team_id.nil? %>
          <%= t("ui.no_team_registered") %>
        <% else %>
          <%= @user.team.team_name %>
        <% end %>
      </p>
    <% end %>
  </div>

  <button class="btn btn-success mb-3" type="button" data-bs-toggle="modal" data-bs-target="#changeModal">
    <%= t("ui.change_password") %>
  </button>

  <div class="modal fade" id="changeModal" tabindex="-1" aria-labelledby="changeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="changeModalLabel"><%= t("ui.change_password") %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('ui.close') %>"></button>
        </div>
        <div class="modal-body">
          <%= t("ui.confirm_password_change") %>
          <br>
          <%= t("ui.password_change_email_notice", email: @user.email) %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("ui.cancel") %></button>
          <%= link_to t("ui.send"), :change_password, :method => :post, class: 'btn btn-success' %>
        </div>
      </div>
    </div>
  </div>

  <div>
    <%= link_to t(:back_to_users), users_path, class: 'btn btn-outline-secondary' %>
  <%= link_to t(:edit_this_user), edit_user_path(@user), class: 'btn btn-outline-info' %>
  </div>
</div>
<% unless @user == current_user %>
  <%= button_to(enable_change_user_path(@user), method: :patch, class: "btn btn-outline-danger mt-3", form: { data: { turbo_confirm: (@user.enabled? ? t("ui.confirm_disable_account") : t("ui.confirm_enable_account")) } }) do %>
    <i class="fa-solid <%= @user.enabled? ? 'fa-eye-slash' : 'fa-eye' %> me-2" aria-hidden="true"></i><%= @user.enabled? ? t("ui.disable_account") : t("ui.enable_account") %>
  <% end %>
<% end %>
