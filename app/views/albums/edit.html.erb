<h1><%= t("ui.edit_resource", resource: t("ui.resources.album").capitalize) %></h1>

<div class="px-3 py-2 border rounded-3">
  <%= form_with(model: @album) do |form| %>
    <% if @album.errors.any? %>
      <div style="color: red">
        <h2><%= t("ui.form_errors", count: @album.errors.count, resource: t("ui.resources.album")) %></h2>

        <ul>
          <% @album.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :name, style: "display: block", class: "form-label" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= label_tag :tournament_name, t("ui.select_tournament_prompt"), class: "form-label" %>
      <%= text_field_tag :tournament_name, @tournament_name, class: "form-control", disabled: true %>
    </div>

    <div class="mb-3" style="display: none">
      <%= form.label :tournament_id %>
      <%= form.text_field :tournament_id, value: @tournament_id %>
    </div>

    <div class="field mb-3">
      <%= form.label :main_image, t("ui.upload_album_cover"), class: "form-label" %>
      <%= form.file_field :main_image, accept: "image/*", class: "form-control" %>
      <% if @album.main_image.present? %>
        <%= image_tag @album.main_image, class: "form-image-preview" %>
      <% end %>
    </div>

    <div class="field mb-3">
      <%= form.label :images, t("ui.upload_images"), class: "form-label" %>
      <%= form.file_field :images, multiple: true, accept: "image/*", class: "form-control" %>
      <% if @album.images.any? %>
        <div class="row">
          <% @album.images.each do |image| %>
            <div class="col-3">
              <%= image_tag image, class: "form-image-preview form-image-preview--gallery" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div>
      <%= form.submit t("ui.save_changes") %>
    </div>
  <% end %>
</div>

<br>

<div>
  <%= link_to t("ui.show_resource", resource: t("ui.resources.album").capitalize), @album, class: "btn btn-primary" %>
</div>
