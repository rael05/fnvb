<% content_for :head do %>
  <style>
    .announcement-show {
      --content-navy: #102b55;
      --content-red: #c9233c;
      --content-muted: #64748b;
      max-width: 960px;
      margin: 0 auto;
      padding: clamp(1.25rem, 4vw, 3rem) 0;
      color: #273449;
    }

    .announcement-show .content-back {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      margin-bottom: 1.25rem;
      color: var(--content-muted);
      text-decoration: none;
    }

    .announcement-show .content-back:hover { color: var(--content-red); }
    .announcement-show .content-panel { overflow: hidden; border: 1px solid #e7edf5; border-radius: 1rem; background: #fff; box-shadow: 0 .75rem 2.25rem rgba(16, 43, 85, .08); }
    .announcement-show .content-header, .announcement-show .content-body { padding: clamp(1.5rem, 4vw, 2.75rem); }
    .announcement-show .content-title { color: var(--content-navy); font-weight: 800; line-height: 1.2; }
    .announcement-show .content-meta { color: var(--content-muted); font-size: .95rem; }
    .announcement-show .content-image { display: block; width: 100%; max-height: 560px; object-fit: cover; background: #f1f5f9; }
    .announcement-show .content-description { font-size: 1.08rem; line-height: 1.8; }
    .announcement-show .content-description p:last-child { margin-bottom: 0; }
    .announcement-show .content-heading { color: var(--content-navy); font-weight: 750; }
    .announcement-show .content-file { height: 100%; border: 1px solid #e7edf5; border-radius: .85rem; background: #f8fafc; }
    .announcement-show .content-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1.5rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid #e7edf5; color: var(--content-muted); font-size: .9rem; }
  </style>
<% end %>

<main class="announcement-show">
  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show" role="status">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('ui.close') %>"></button>
    </div>
  <% end %>

  <%= link_to announcements_path, class: "content-back" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span><%= t("ui.back_to_announcements") %></span>
  <% end %>

  <article class="content-panel">
    <header class="content-header">
      <span class="text-danger fw-bold text-uppercase small"><%= t("ui.announcements_heading") %></span>
      <h1 class="content-title display-6 mt-2 mb-3"><%= @announcement.title %></h1>
      <p class="content-meta mb-0"><i class="fa-regular fa-calendar me-2" aria-hidden="true"></i><%= t("ui.published_on") %> <%= l(@announcement.created_at.to_date, format: :long) %></p>
    </header>

    <% if @announcement.image.present? %>
      <%= image_tag @announcement.image, alt: @announcement.title, class: "content-image" %>
    <% end %>

    <div class="content-body">
      <% if @announcement.description.present? %>
        <div class="content-description"><%= simple_format @announcement.description %></div>
      <% end %>

      <% if @announcement.pdf_es_file.present? || @announcement.pdf_en_file.present? %>
        <section class="mt-5" aria-labelledby="announcement-files-heading">
          <h2 id="announcement-files-heading" class="content-heading h4 mb-3"><%= t("ui.attached_documents") %></h2>
          <div class="row g-3">
            <% if @announcement.pdf_es_file.present? %>
              <div class="col-md-6">
                <div class="content-file p-3 p-md-4">
                  <div class="d-flex gap-3">
                    <i class="fa-regular fa-file-pdf fs-3 text-danger" aria-hidden="true"></i>
                    <div class="min-w-0">
                      <h3 class="h6 fw-bold mb-1"><%= t("ui.spanish_document") %></h3>
                      <p class="small text-secondary text-break mb-3"><%= @announcement.pdf_es_file.filename %></p>
                      <div class="d-flex flex-wrap gap-3">
                        <%= link_to t("ui.view_file"), rails_blob_path(@announcement.pdf_es_file, disposition: "preview"), target: "_blank", rel: "noopener noreferrer" %>
                        <%= link_to t("ui.download"), rails_blob_path(@announcement.pdf_es_file, disposition: "attachment") %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
            <% if @announcement.pdf_en_file.present? %>
              <div class="col-md-6">
                <div class="content-file p-3 p-md-4">
                  <div class="d-flex gap-3">
                    <i class="fa-regular fa-file-pdf fs-3 text-danger" aria-hidden="true"></i>
                    <div class="min-w-0">
                      <h3 class="h6 fw-bold mb-1"><%= t("ui.english_document") %></h3>
                      <p class="small text-secondary text-break mb-3"><%= @announcement.pdf_en_file.filename %></p>
                      <div class="d-flex flex-wrap gap-3">
                        <%= link_to t("ui.view_file"), rails_blob_path(@announcement.pdf_en_file, disposition: "preview"), target: "_blank", rel: "noopener noreferrer" %>
                        <%= link_to t("ui.download"), rails_blob_path(@announcement.pdf_en_file, disposition: "attachment") %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <footer class="content-footer">
        <span><%= t("ui.last_updated") %>: <%= l(@announcement.updated_at.to_date, format: :long) %></span>
        <span><%= t("ui.author") %> <%= @announcement.user.full_name %></span>
      </footer>
    </div>
  </article>

  <div class="d-flex flex-wrap gap-2 mt-3">
    <%= link_to t("ui.back_to_announcements"), announcements_path, class: "btn btn-outline-secondary rounded-pill px-4" %>
    <%= link_to t("ui.edit_resource", resource: t("ui.resources.announcement").capitalize), edit_announcement_path(@announcement), class: "btn btn-outline-primary rounded-pill px-4" %>
    <% if can?(:enable_change, @announcement) %>
      <%= button_to(enable_change_announcement_path(@announcement), method: :patch, class: "btn #{'btn-outline-danger' if @announcement.enabled?} #{'btn-outline-success' unless @announcement.enabled?} rounded-pill px-4", form: { data: { turbo_confirm: t("ui.confirm_toggle", action: @announcement.enabled? ? t("ui.disable").downcase : t("ui.enable").downcase, resource: t("ui.resources.announcement"), name: @announcement.title) } }) do %>
        <i class="fa-solid <%= @announcement.enabled? ? 'fa-eye-slash' : 'fa-eye' %> me-2" aria-hidden="true"></i><%= @announcement.enabled? ? t("ui.disable_announcement") : t("ui.enable_announcement") %>
      <% end %>
    <% end %>
  </div>
</main>
