<meta charset="utf-8" />
<style>
  body { color: #26364f; font-family: Arial, sans-serif; font-size: 9.5pt; }
  h1, h2, h3 { color: #172b4d; }
  .header { border-bottom: 3px solid #c9273b; margin-bottom: 22px; padding-bottom: 13px; }
  .brand { color: #172b4d; font-size: 10pt; font-weight: bold; letter-spacing: 1px; text-align: center; text-transform: uppercase; }
  .report-title { margin: 13px 0 4px; text-align: center; }
  .team-name { font-size: 25pt; font-weight: bold; }
  .generated { color: #748198; font-size: 8.5pt; text-align: center; }
  .section-title { border-bottom: 1px solid #dfe5ed; font-size: 12pt; margin: 20px 0 9px; padding-bottom: 6px; }
  .meta { border-collapse: collapse; width: 100%; }
  .meta td { border: 1px solid #e2e7ee; padding: 8px 10px; vertical-align: top; width: 50%; }
  .meta tr:nth-child(odd) td { background: #f7f9fc; }
  .label { color: #718096; display: block; font-size: 7.5pt; font-weight: bold; letter-spacing: .4px; margin-bottom: 3px; text-transform: uppercase; }
  .value { color: #26364f; font-size: 9pt; }
  .status { color: #18764b; font-size: 8.5pt; font-weight: bold; }
  .status--disabled { color: #a72938; }
  .uniforms { border-collapse: collapse; width: 100%; }
  .uniforms th, .uniforms td { border: 1px solid #dfe5ed; padding: 7px 9px; text-align: left; }
  .uniforms th { background: #eef2f7; color: #52647e; font-size: 8pt; }
  .players { border-collapse: collapse; width: 100%; }
  .players thead { display: table-header-group; }
  .players th, .players td { border: 1px solid #dfe5ed; padding: 6px 7px; text-align: left; }
  .players th { background: #172b4d; color: #fff; font-size: 8pt; }
  .players tbody tr:nth-child(even) { background: #f5f7fa; }
  .players tr { page-break-inside: avoid; }
  .number { text-align: center !important; width: 8%; }
  .empty { background: #f7f9fc; color: #748198; padding: 12px; }
  .footer { border-top: 1px solid #dfe5ed; color: #8994a5; font-size: 8pt; margin-top: 20px; padding-top: 8px; text-align: center; }
</style>

<div class="header">
  <div class="brand"><%= t("ui.federation_brand") %></div>
  <div class="report-title">
    <div class="label"><%= t("ui.team_profile") %></div>
    <div class="team-name"><%= @team.team_name %></div>
  </div>
  <div class="generated"><%= t("ui.report_generated_at") %> <%= l(Time.current, format: :long) %></div>
</div>

<h2 class="section-title"><%= t("ui.general_information") %></h2>
<table class="meta">
  <tr>
    <td><span class="label"><%= t("ui.status") %></span><span class="status <%= 'status--disabled' unless @team.enabled? %>"><%= @team.enabled? ? t("ui.enabled") : t("ui.disabled") %></span></td>
    <td><span class="label"><%= t(:tournaments) %></span><span class="value"><%= @team.tournaments.map(&:name).presence&.join(", ") || t("ui.no_tournament_assigned") %></span></td>
  </tr>
  <tr>
    <td><span class="label"><%= t("ui.delegate") %></span><span class="value"><%= [@team.delegate_name, @team.delegate_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></span></td>
    <td><span class="label"><%= t("ui.head_coach") %></span><span class="value"><%= [@team.head_coach_name, @team.head_coach_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></span></td>
  </tr>
  <tr>
    <td><span class="label"><%= t("ui.assistant_coach") %> 1</span><span class="value"><%= [@team.assistant_coach1_name, @team.assistant_coach1_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></span></td>
    <td><span class="label"><%= t("ui.assistant_coach") %> 2</span><span class="value"><%= [@team.assistant_coach2_name, @team.assistant_coach2_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></span></td>
  </tr>
  <tr>
    <td><span class="label"><%= t("ui.doctor") %></span><span class="value"><%= [@team.doctor_name, @team.doctor_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></span></td>
    <td><span class="label"><%= t("ui.physiotherapist") %></span><span class="value"><%= [@team.physiotherapist_name, @team.physiotherapist_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></span></td>
  </tr>
  <tr>
    <td><span class="label"><%= t("statistical_name") %></span><span class="value"><%= [@team.statistical_name, @team.statistical_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></span></td>
    <td><span class="label"><%= t("ui.international_referee") %></span><span class="value"><%= [@team.international_referee_name, @team.international_referee_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></span></td>
  </tr>
</table>

<h2 class="section-title"><%= t("ui.uniforms") %></h2>
<table class="uniforms">
  <thead><tr><th><%= t("ui.uniform") %></th><th><%= t("ui.jersey") %></th><th><%= t("ui.shorts") %></th></tr></thead>
  <tbody>
    <% [1, 2, 3].each do |number| %>
      <% shirt_color = @team.public_send("color_shirt#{number}") %>
      <% short_color = @team.public_send("color_short#{number}") %>
      <% next if shirt_color.blank? && short_color.blank? %>
      <tr>
        <td><strong><%= number %></strong></td>
        <td><%= shirt_color.presence || "—" %></td>
        <td><%= short_color.presence || "—" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2 class="section-title"><%= t("ui.registered_players", count: @team.players.size) %></h2>
<% if @team.players.any? %>
  <table class="players">
    <thead>
      <tr><th class="number"><%= t("ui.number_abbr") %></th><th><%= t("ui.full_name") %></th><th><%= t("ui.position") %></th><th><%= t("ui.height") %></th><th><%= t("ui.weight") %></th><th><%= t("ui.nationality") %></th><th><%= t("ui.birth_date") %></th></tr>
    </thead>
    <tbody>
      <% @team.players.sort_by { |player| [player.number || 999, player.last_name.to_s] }.each do |player| %>
        <tr>
          <td class="number"><%= player.number || "—" %></td>
          <td><%= [player.name, player.last_name].compact_blank.join(" ") %></td>
          <td><%= player.position.present? ? t("ui.positions.#{player.position}", default: player.position) : "—" %></td>
          <td><%= player.height.present? ? "#{player.height} m" : "—" %></td>
          <td><%= player.weight.present? ? "#{player.weight} kg" : "—" %></td>
          <td><%= player.nationality.presence || "—" %></td>
          <td><%= player.birthday.present? ? l(player.birthday, format: :long) : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty"><%= t("ui.no_players_registered") %></div>
<% end %>

<div class="footer"><%= t("ui.federation_brand") %></div>
