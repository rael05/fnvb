<p style="color: green"><%= notice %></p>

<div class="shadow p-3 rounded-3">
  <h1 class="text-center border-bottom pb-2">
    <%= t(:teams) %>
    <a href="<%= new_team_path %>" style="text-decoration: none" class="ms-3">
      <i class="fa-solid fa-circle-plus fa-xs"></i>
    </a>
  </h1>

  <!-- Formulario de búsqueda -->
  <div class="text-center mt-3">
    <%= form_with url: teams_path, method: :get, local: true, class: "d-inline-block w-50" do |form| %>
      <div class="input-group">
        <%= form.text_field :search, value: params[:search], placeholder: t(:search_by_name), class: "form-control" %>
        <button type="submit" class="btn btn-outline-primary">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>
    <% end %>
  </div>

  <div id="teams" class="mt-2 row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
    <% @teams.each_with_index do |team, index| %>
      <div class="col">
        <div class="card <%= "bg-black bg-opacity-25" unless team.enabled %>">
          <a href="<%= team_path(team) %>">
            <% if team.image.present? %>
              <%= image_tag team.image, class: 'card-img-top directory-card__image', style: ('opacity: 0.3;' unless team.enabled?) %>
            <% else %>
              <%= image_tag("tournament_ball.jpg", alt: t("ui.default_image_alt"), class: 'card-img-top directory-card__image', style: ('opacity: 0.3;' unless team.enabled?)) %>
            <% end %>
          </a>
          <div class="card-body">
            <h4 class="card-title text-center">
              <a href="<%= team_path(team) %>" class="link-dark" style="text-decoration: none">
                <%= team.team_name %>
              </a>
            </h4>
            <strong style="font-size: 15px;"><%= t("delegate_name") %>:</strong>
            <p class="card-text">
              <%= [team.delegate_name, team.delegate_last_name].compact_blank.presence&.join(" ") || t("ui.undefined") %>
            </p>
            <strong style="font-size: 15px;"><%= t("ui.coach") %>:</strong>
            <p class="card-text">
              <%= [team.head_coach_name, team.head_coach_last_name].compact_blank.presence&.join(" ") || t("ui.undefined") %>
            </p>
          </div>
          <div class="card-footer">
            <small class="text-body-secondary">
              <div class="row ms-0 mt-1">
                <div class="border rounded-circle position-relative bg-white" style="width: 30px; height: 30px">
                  <a href="<%= edit_team_path(team) %>" style="text-decoration: none" class="link-success position-absolute top-50 start-50 translate-middle">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </a>
                </div>
                <div class="border rounded-circle position-relative bg-white ms-1" style="width: 30px; height: 30px">
                  <!-- Botón para abrir el modal -->
                  <a href="#" data-bs-toggle="modal" data-bs-target="#modal-<%= index %>" style="text-decoration: none" class="link-danger position-absolute top-50 start-50 translate-middle">
                    <i class="fa-solid <%= team.enabled ? 'fa-eye-slash' : 'fa-eye' %>"></i>
                  </a>
                </div>
              </div>
            </small>
          </div>
        </div>
      </div>

      <!-- Modal para cambiar enabled -->
      <div class="modal fade" id="modal-<%= index %>" tabindex="-1" aria-labelledby="modalLabel-<%= index %>" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="modalLabel-<%= index %>">
                <%= t(team.enabled? ? "ui.confirm_disable_team" : "ui.confirm_enable_team") %>
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('ui.close') %>"></button>
            </div>
            <div class="modal-body">
              <%= t(team.enabled? ? "ui.confirm_disable_team" : "ui.confirm_enable_team") %>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("ui.cancel") %></button>
              <% if can?(:enable_change, team) %>
                <%= button_to(enable_change_team_path(team), method: :patch, class: "btn btn-danger", form: { data: { turbo: false } }) do %>
                  <i class="fa-solid <%= team.enabled? ? 'fa-eye-slash' : 'fa-eye' %> me-2" aria-hidden="true"></i><%= team.enabled? ? t("ui.disable") : t("ui.enable") %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <nav class="mt-4" aria-label="<%= t('ui.pagination_teams') %>">
      <ul class="pagination justify-content-center mb-0">
        <li class="page-item <%= 'disabled' if @current_page == 1 %>">
          <%= link_to t("ui.previous"), teams_path(page: @current_page - 1, search: params[:search]), class: 'page-link', aria: { label: t("ui.previous") } %>
        </li>
        <% (1..@total_pages).each do |page| %>
          <li class="page-item <%= 'active' if page == @current_page %>">
            <%= link_to page, teams_path(page: page, search: params[:search]), class: 'page-link', aria: { current: (page == @current_page ? 'page' : nil) } %>
          </li>
        <% end %>
        <li class="page-item <%= 'disabled' if @current_page == @total_pages %>">
          <%= link_to t("ui.next"), teams_path(page: @current_page + 1, search: params[:search]), class: 'page-link', aria: { label: t("ui.next") } %>
        </li>
      </ul>
    </nav>
  <% end %>

  <%= link_to t(:new_team), new_team_path, class: 'btn btn-primary mt-3' %>
</div>
