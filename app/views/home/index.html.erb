<% content_for :head do %>
  <style>
    .home-page {
      --home-navy: #102b55;
      --home-blue: #124a91;
      --home-red: #c9233c;
      --home-muted: #64748b;
      color: #1f2937;
    }

    .home-hero {
      position: relative;
      min-height: clamp(280px, 42vw, 520px);
      overflow: hidden;
      border-radius: 0 0 1.25rem 1.25rem;
      background: var(--home-navy);
    }

    .home-hero img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .home-hero::after {
      position: absolute;
      inset: 0;
      content: "";
      background: linear-gradient(90deg, rgba(8, 27, 56, .82), rgba(8, 27, 56, .08));
    }

    .home-hero-content {
      position: relative;
      z-index: 1;
      display: flex;
      min-height: inherit;
      max-width: 38rem;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      padding: clamp(2rem, 7vw, 5rem);
      color: #fff;
    }

    .home-eyebrow {
      color: #f7c948;
      font-size: .8rem;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
    }

    .home-section { padding: clamp(2.5rem, 6vw, 4.5rem) 0; }

    .home-section-heading {
      margin-bottom: 1.5rem;
      color: var(--home-navy);
      font-weight: 800;
      letter-spacing: .02em;
    }

    .home-section-heading::after {
      display: block;
      width: 3.5rem;
      height: .22rem;
      margin-top: .8rem;
      border-radius: 1rem;
      background: var(--home-red);
      content: "";
    }

    .home-article-card {
      display: block;
      height: 100%;
      overflow: hidden;
      border: 0;
      border-radius: 1rem;
      color: inherit;
      text-decoration: none;
      box-shadow: 0 .5rem 1.5rem rgba(16, 43, 85, .1);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .home-article-card:hover {
      color: inherit;
      transform: translateY(-4px);
      box-shadow: 0 .9rem 2rem rgba(16, 43, 85, .16);
    }

    .home-article-image { width: 100%; height: 230px; object-fit: cover; }
    .home-article-title { color: var(--home-navy); font-weight: 700; }

    .home-partners { background: #f5f7fb; }

    .home-logo-card {
      display: flex;
      min-height: 150px;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      border: 1px solid #e8edf4;
      border-radius: .9rem;
      background: #fff;
    }

    .home-logo-card img { max-width: 100%; max-height: 105px; object-fit: contain; }

    @media (prefers-reduced-motion: reduce) {
      .home-article-card { transition: none; }
    }
  </style>
<% end %>

<main class="home-page">
  <section class="home-hero" aria-label="Federación Nicaragüense de Voleibol">
    <%= image_tag("banner.jpeg", alt: "Jugadores y actividades de voleibol") %>
    <div class="home-hero-content">
      <span class="home-eyebrow">Federación Nicaragüense de Voleibol</span>
      <h1 class="display-4 fw-bold mt-3">Pasión que se juega en equipo</h1>
      <p class="lead mb-4">Actualidad, competencias y desarrollo del voleibol nicaragüense.</p>
      <%= link_to "Explorar torneos", tournaments_path, class: "btn btn-danger btn-lg rounded-pill px-4" %>
    </div>
  </section>

  <section class="home-section" aria-labelledby="home-news-heading">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
      <div>
        <span class="home-eyebrow text-danger">En la cancha</span>
        <h2 id="home-news-heading" class="home-section-heading mb-0"><%= t(:last_new) %></h2>
      </div>
      <%= link_to "Ver más noticias", articles_path, class: "btn btn-outline-primary rounded-pill px-4" %>
    </div>

    <div class="row g-4">
      <% @threeArticles.each do |article| %>
        <div class="col-xl-4 col-md-6">
          <%= link_to article_path(article), class: "home-article-card" do %>
            <%= image_tag(article.image, alt: article.title, class: "home-article-image") %>
            <div class="p-4">
              <h3 class="h5 home-article-title mb-0"><%= article.title %></h3>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="home-section home-partners" aria-labelledby="home-events-heading">
    <div class="container-fluid px-0">
      <span class="home-eyebrow text-danger">Competencia internacional</span>
      <h2 id="home-events-heading" class="home-section-heading">Eventos de ciclo olímpico</h2>
      <div class="row g-3">
        <% [["eco1.png", "Evento de ciclo olímpico"], ["eco2.png", "Evento de ciclo olímpico"], ["eco3.jpg", "Evento de ciclo olímpico"], ["eco4.png", "Evento de ciclo olímpico"]].each do |image, description| %>
          <div class="col-6 col-lg-3">
            <div class="home-logo-card"><%= image_tag(image, alt: description) %></div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="home-sponsors-heading">
    <span class="home-eyebrow text-danger">Con el apoyo de</span>
    <h2 id="home-sponsors-heading" class="home-section-heading">Patrocinadores Programa TOP COI</h2>
    <div class="row g-3">
      <% [["ppt1.png", "Patrocinador"], ["ppt2.png", "Patrocinador"], ["ppt3.png", "Patrocinador"], ["ppt4.png", "Patrocinador"], ["ppt5.jpg", "Patrocinador"], ["ppt6.jpg", "Patrocinador"], ["ppt7.png", "Patrocinador"], ["ppt8.png", "Patrocinador"]].each do |image, description| %>
        <div class="col-6 col-lg-3">
          <div class="home-logo-card"><%= image_tag(image, alt: description) %></div>
        </div>
      <% end %>
    </div>
  </section>
</main>
