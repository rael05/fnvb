<% content_for :head do %>
  <style>
    .article-show {
      --article-navy: #102b55;
      --article-red: #c9233c;
      --article-muted: #64748b;
      margin: 0 auto;
      color: #273449;
    }

    .article-show-back {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      margin-bottom: 1.25rem;
      color: var(--article-muted);
      text-decoration: none;
    }

    .article-show-back:hover { color: var(--article-red); }

    .article-show-panel {
      overflow: hidden;
      border: 1px solid #e7edf5;
      border-radius: 1rem;
      background: #fff;
      box-shadow: 0 .75rem 2.25rem rgba(16, 43, 85, .08);
    }

    .article-show-header { padding: clamp(1.5rem, 4vw, 2.75rem); }
    .article-show-title { color: var(--article-navy); font-weight: 800; line-height: 1.2; }
    .article-show-meta { color: var(--article-muted); font-size: .95rem; }

    .article-show-image {
      display: block;
      width: 100%;
      max-height: 560px;
      object-fit: cover;
      background: #f1f5f9;
    }

    .article-show-content { padding: clamp(1.5rem, 4vw, 2.75rem); }
    .article-show-description { font-size: 1.08rem; line-height: 1.8; }
    .article-show-description p:last-child { margin-bottom: 0; }

    .article-show-subheading {
      color: var(--article-navy);
      font-weight: 750;
    }

    .article-file-card {
      height: 100%;
      border: 1px solid #e7edf5;
      border-radius: .85rem;
      background: #f8fafc;
    }

    .article-show-footer {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: .5rem 1.5rem;
      margin-top: 2rem;
      padding-top: 1.25rem;
      border-top: 1px solid #e7edf5;
      color: var(--article-muted);
      font-size: .9rem;
    }
  </style>
<% end %>

<main class="article-show pt-3">
  <%= link_to articles_path, class: "article-show-back" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    <span><%= t("ui.back_to_articles") %></span>
  <% end %>

  <article class="article-show-panel">
    <header class="article-show-header">
      <span class="text-danger fw-bold text-uppercase small"><%= t("ui.articles_heading") %></span>
      <h1 class="article-show-title display-6 mt-2 mb-3"><%= @article.title %></h1>
      <p class="article-show-meta mb-0">
        <i class="fa-regular fa-calendar me-2" aria-hidden="true"></i>
        Publicado el <%= l(@article.created_at.to_date, format: :long) %>
      </p>
    </header>

    <% if @article.image.present? %>
      <%= image_tag @article.image, alt: @article.title, class: "article-show-image" %>
    <% end %>

    <div class="article-show-content">
      <% if @article.description.present? %>
        <div class="article-show-description"><%= simple_format @article.description %></div>
      <% end %>

      <% if @article.pdf_es_file.present? || @article.pdf_en_file.present? %>
        <section class="mt-5" aria-labelledby="article-files-heading">
          <h2 id="article-files-heading" class="article-show-subheading h4 mb-3"><%= t("ui.attached_documents") %></h2>
          <div class="row g-3">
            <% if @article.pdf_es_file.present? %>
              <div class="col-md-6">
                <div class="article-file-card p-3 p-md-4">
                  <div class="d-flex gap-3">
                    <i class="fa-regular fa-file-pdf fs-3 text-danger" aria-hidden="true"></i>
                    <div class="min-w-0">
                      <h3 class="h6 fw-bold mb-1"><%= t("ui.spanish_document") %></h3>
                      <p class="small text-secondary text-break mb-3"><%= @article.pdf_es_file.filename %></p>
                      <div class="d-flex flex-wrap gap-3">
                        <%= link_to t("ui.view_file"), rails_blob_path(@article.pdf_es_file, disposition: "preview"), target: "_blank", rel: "noopener noreferrer", class: "link-primary" %>
                        <%= link_to t("ui.download"), rails_blob_path(@article.pdf_es_file, disposition: "attachment"), class: "link-primary" %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <% if @article.pdf_en_file.present? %>
              <div class="col-md-6">
                <div class="article-file-card p-3 p-md-4">
                  <div class="d-flex gap-3">
                    <i class="fa-regular fa-file-pdf fs-3 text-danger" aria-hidden="true"></i>
                    <div class="min-w-0">
                      <h3 class="h6 fw-bold mb-1"><%= t("ui.english_document") %></h3>
                      <p class="small text-secondary text-break mb-3"><%= @article.pdf_en_file.filename %></p>
                      <div class="d-flex flex-wrap gap-3">
                        <%= link_to t("ui.view_file"), rails_blob_path(@article.pdf_en_file, disposition: "preview"), target: "_blank", rel: "noopener noreferrer", class: "link-primary" %>
                        <%= link_to t("ui.download"), rails_blob_path(@article.pdf_en_file, disposition: "attachment"), class: "link-primary" %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <footer class="article-show-footer">
        <span><%= t("ui.last_updated") %>: <%= l(@article.updated_at.to_date, format: :long) %></span>
        <span><%= t("ui.author") %> <%= @article.user.full_name %></span>
      </footer>
    </div>
  </article>

  <div class="d-flex flex-wrap gap-2 mt-3">
    <%= link_to t("ui.back_to_articles"), articles_path, class: "btn btn-outline-secondary rounded-pill px-4" %>
    <%= link_to t("ui.edit_resource", resource: t("ui.resources.article").capitalize), edit_article_path(@article), class: "btn btn-outline-primary rounded-pill px-4" %>
    <% if can?(:enable_change, @article) %>
      <%= button_to(enable_change_article_path(@article), method: :patch, class: "btn #{'btn-outline-danger' if @article.enabled?} #{'btn-outline-success' unless @article.enabled?} rounded-pill px-4", form: { data: { turbo_confirm: t("ui.confirm_toggle", action: @article.enabled? ? t("ui.disable").downcase : t("ui.enable").downcase, resource: t("ui.resources.article"), name: @article.title) } }) do %>
        <i class="fa-solid <%= @article.enabled? ? 'fa-eye-slash' : 'fa-eye' %> me-2" aria-hidden="true"></i><%= @article.enabled? ? t("ui.disable_article") : t("ui.enable_article") %>
      <% end %>
    <% end %>
  </div>
</main>
