<div id="<%= dom_id game %>">
  <p>
    <strong><%= t("ui.winner_team") %>:</strong>
    <%= game.winning_team %>
  </p>

  <p>
    <strong><%= t("ui.loser_team") %>:</strong>
    <%= game.lose_team %>
  </p>

  <p>
    <strong><%= t("ui.winning_score") %>:</strong>
    <%= game.win_score %>
  </p>

  <p>
    <strong><%= t("ui.losing_score") %>:</strong>
    <%= game.lose_score %>
  </p>

  <p>
    <strong><%= t("ui.user") %>:</strong>
    <%= game.user_id %>
  </p>

  <p>
    <strong><%= t("ui.description") %>:</strong>
    <%= game.description %>
  </p>

</div>
