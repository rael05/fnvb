<% content_for :head do %>
  <%= javascript_import_module_tag "game_form" %>
<% end %>

<h1><%= t("ui.new_resource", resource: t("ui.resources.game").capitalize) %></h1>

<div class="px-3 py-2 border rounded-3">
  <%= form_with(model: @game) do |form| %>
    <% if @game.errors.any? %>
      <div style="color: red">
        <h2><%= t("ui.form_errors", count: @game.errors.count, resource: t("ui.resources.game")) %></h2>

        <ul>
          <% @game.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.number_field  :calendar_id, class: "d-none" %>

    <div class="mb-3">
      <%= label_tag "calendar_status", t("ui.match_status"), class: "form-label" %>
      <%= select_tag "calendar[status]", options_for_select(Calendar::TYPE_STATUS.map { |key, value| [t(key), value] }, @calendar.status), class: "form-select", id: "calendar_status" %>
    </div>

    <div class="mb-3">
      <%= form.label :description, t("ui.description"), style: "display: block", class: "form-label" %>
      <%= form.text_field :description, class: "form-control" %>
    </div>

    <div>
      <%= form.submit(@calendar.status == Calendar::TYPE_STATUS[:in_progress] ? t("ui.add_plays") : t("ui.save_changes"), class: "btn btn-primary mb-2", id: "game_submit", data: { default_label: t("ui.save_changes"), in_progress_label: t("ui.add_plays") }) %>
    </div>
  <% end %>
</div>

<br>

<div>
  <%= link_to t("ui.back_to_games"), games_path, class: 'btn btn-outline-secondary' %>
</div>
