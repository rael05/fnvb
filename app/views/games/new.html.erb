<% content_for :head do %>
  <%= javascript_import_module_tag "game_form" %>
<% end %>

<h1><%= t("ui.new_resource", resource: t("ui.resources.game").capitalize) %></h1>

<div class="px-3 py-2 border rounded-3">
  <%= form_with(model: @game) do |form| %>
    <% if @game.errors.any? %>
      <div style="color: red">
        <h2><%= t("ui.form_errors", count: @game.errors.count, resource: t("ui.resources.game")) %></h2>

        <ul>
          <% @game.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.number_field  :calendar_id, class: "d-none" %>

    <div class="mb-3 row">
      <div class="col">
        <%= form.label :winning_team, t("ui.winning_team"), style: "display: block", class: "form-label" %>
        <%= form.select(:winning_team, options_for_select(@team_options, @winning_team), {}, class: "form-select") %>
      </div>

      <div class="col">
        <%= form.label :lose_team, t("ui.loser_team"), style: "display: block", class: "form-label" %>
        <%= form.select(:lose_team, options_for_select(@team_options, @lose_team), {}, class: "form-select") %>
      </div>
    </div>

    <div class="mb-3 row">
      <div class="col">
        <%= form.label :win_score, t("ui.winning_score"), style: "display: block", class: "form-label" %>
        <%= form.number_field :win_score, class: "form-control", min: 0, max: 5 %>
      </div>

      <div class="col">
        <%= form.label :lose_score, t("ui.losing_score"), style: "display: block", class: "form-label" %>
        <%= form.number_field :lose_score, class: "form-control", min: 0, max: 5 %>
      </div>
    </div>

    <div class="mb-3">
      <%= form.label :description, t("ui.description"), style: "display: block", class: "form-label" %>
      <%= form.text_field :description, class: "form-control" %>
    </div>

    <div>
      <%= form.submit t("ui.save_changes"), class: "btn btn-primary mb-2" %>
    </div>
  <% end %>
</div>

<br>

<div>
  <%= link_to t("ui.back_to_games"), games_path, class: 'btn btn-outline-secondary' %>
</div>
