<div class="px-3 py-2 border rounded-bottom">
  <%= form_with(model: statistic) do |form| %>
    <% if statistic.errors.any? %>
      <div style="color: red">
        <h2><%= t("ui.form_errors", count: statistic.errors.count, resource: t("ui.resources.statistic")) %></h2>

        <ul>
          <% statistic.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :title, t("ui.title"), class: "form-label" %>
      <%= form.text_field :title, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :description, t("ui.description"), class: "form-label" %>
      <%= form.text_area :description, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :pdf_es_file, t("ui.pdf_statistic_es"), class: "form-label" %>
      <% if statistic.pdf_es_file.present? %>
        Arcivo actual: <strong> <%= statistic.pdf_es_file.filename %> </strong> <br>
      <% end %>
      <%= form.file_field :pdf_es_file, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :pdf_en_file, t("ui.pdf_statistic_en"), class: "form-label" %>
      <% if statistic.pdf_en_file.present? %>
        Arcivo actual: <strong> <%= statistic.pdf_en_file.filename %> </strong> <br>
      <% end %>
      <%= form.file_field :pdf_en_file, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :image, t("ui.statistic_image"), class: "form-label" %>
      <% if statistic.image.present? %>
        <%= image_tag statistic.image, class: "form-image-preview" %>
      <% end %>
      <%= form.file_field :image, class: "form-control" %>
    </div>

    <div>
      <%= form.submit t("ui.save_changes"), class: "btn btn-primary mb-2" %>
    </div>
  <% end %>
</div>
