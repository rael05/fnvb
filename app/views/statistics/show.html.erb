<% content_for :head do %>
  <style>
    .statistic-show {
      --content-navy: #102b55;
      --content-red: #c9233c;
      --content-muted: #64748b;
      max-width: 960px;
      margin: 0 auto;
      padding: clamp(1.25rem, 4vw, 3rem) 0;
      color: #273449;
    }

    .statistic-show .content-back { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: 1.25rem; color: var(--content-muted); text-decoration: none; }
    .statistic-show .content-back:hover { color: var(--content-red); }
    .statistic-show .content-panel { overflow: hidden; border: 1px solid #e7edf5; border-radius: 1rem; background: #fff; box-shadow: 0 .75rem 2.25rem rgba(16, 43, 85, .08); }
    .statistic-show .content-header, .statistic-show .content-body { padding: clamp(1.5rem, 4vw, 2.75rem); }
    .statistic-show .content-title { color: var(--content-navy); font-weight: 800; line-height: 1.2; }
    .statistic-show .content-meta { color: var(--content-muted); font-size: .95rem; }
    .statistic-show .content-image { display: block; width: 100%; max-height: 560px; object-fit: cover; background: #f1f5f9; }
    .statistic-show .content-description { font-size: 1.08rem; line-height: 1.8; }
    .statistic-show .content-description p:last-child { margin-bottom: 0; }
    .statistic-show .content-heading { color: var(--content-navy); font-weight: 750; }
    .statistic-show .content-file { height: 100%; border: 1px solid #e7edf5; border-radius: .85rem; background: #f8fafc; }
    .statistic-show .content-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1.5rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid #e7edf5; color: var(--content-muted); font-size: .9rem; }
  </style>
<% end %>

<main class="statistic-show">
  <%= link_to statistics_path, class: "content-back" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span><%= t("ui.back_to_statistics") %></span>
  <% end %>

  <article class="content-panel">
    <header class="content-header">
      <span class="text-danger fw-bold text-uppercase small"><%= t("ui.statistics_heading") %></span>
      <h1 class="content-title display-6 mt-2 mb-3"><%= @statistic.title %></h1>
      <p class="content-meta mb-0"><i class="fa-regular fa-calendar me-2" aria-hidden="true"></i><%= t("ui.published_on") %> <%= l(@statistic.created_at.to_date, format: :long) %></p>
    </header>

    <% if @statistic.image.present? %>
      <%= image_tag @statistic.image, alt: @statistic.title, class: "content-image" %>
    <% end %>

    <div class="content-body">
      <div class="content-description"><%= simple_format @statistic.description %></div>

      <% if @statistic.pdf_es_file.present? || @statistic.pdf_en_file.present? %>
        <section class="mt-5" aria-labelledby="statistic-files-heading">
          <h2 id="statistic-files-heading" class="content-heading h4 mb-3"><%= t("ui.attached_documents") %></h2>
          <div class="row g-3">
            <% if @statistic.pdf_es_file.present? %>
              <div class="col-md-6">
                <div class="content-file p-3 p-md-4">
                  <div class="d-flex gap-3">
                    <i class="fa-regular fa-file-pdf fs-3 text-danger" aria-hidden="true"></i>
                    <div class="min-w-0">
                      <h3 class="h6 fw-bold mb-1"><%= t("ui.spanish_document") %></h3>
                      <p class="small text-secondary text-break mb-3"><%= @statistic.pdf_es_file.filename %></p>
                      <div class="d-flex flex-wrap gap-3">
                        <%= link_to t("ui.view_file"), rails_blob_path(@statistic.pdf_es_file, disposition: "preview"), target: "_blank", rel: "noopener noreferrer" %>
                        <%= link_to t("ui.download"), rails_blob_path(@statistic.pdf_es_file, disposition: "attachment") %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
            <% if @statistic.pdf_en_file.present? %>
              <div class="col-md-6">
                <div class="content-file p-3 p-md-4">
                  <div class="d-flex gap-3">
                    <i class="fa-regular fa-file-pdf fs-3 text-danger" aria-hidden="true"></i>
                    <div class="min-w-0">
                      <h3 class="h6 fw-bold mb-1"><%= t("ui.english_document") %></h3>
                      <p class="small text-secondary text-break mb-3"><%= @statistic.pdf_en_file.filename %></p>
                      <div class="d-flex flex-wrap gap-3">
                        <%= link_to t("ui.view_file"), rails_blob_path(@statistic.pdf_en_file, disposition: "preview"), target: "_blank", rel: "noopener noreferrer" %>
                        <%= link_to t("ui.download"), rails_blob_path(@statistic.pdf_en_file, disposition: "attachment") %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <footer class="content-footer">
        <span><%= t("ui.last_updated") %>: <%= l(@statistic.updated_at.to_date, format: :long) %></span>
        <span><%= t("ui.author") %> <%= @statistic.user.full_name %></span>
      </footer>
    </div>
  </article>

  <div class="d-flex flex-wrap gap-2 mt-3">
    <%= link_to t("ui.back_to_statistics"), statistics_path, class: "btn btn-outline-secondary rounded-pill px-4" %>
    <%= link_to t("ui.edit_resource", resource: t("ui.resources.statistic").capitalize), edit_statistic_path(@statistic), class: "btn btn-outline-primary rounded-pill px-4" %>
    <% if can?(:enable_change, @statistic) %>
      <%= button_to(enable_change_statistic_path(@statistic), method: :patch, class: "btn #{'btn-outline-danger' if @statistic.enabled?} #{'btn-outline-success' unless @statistic.enabled?} rounded-pill px-4", form: { data: { turbo_confirm: t("ui.confirm_toggle", action: @statistic.enabled? ? t("ui.disable").downcase : t("ui.enable").downcase, resource: t("ui.resources.statistic"), name: @statistic.title) } }) do %>
        <i class="fa-solid <%= @statistic.enabled? ? 'fa-eye-slash' : 'fa-eye' %> me-2" aria-hidden="true"></i><%= @statistic.enabled? ? t("ui.disable_statistic") : t("ui.enable_statistic") %>
      <% end %>
    <% end %>
  </div>
</main>
