<%= form_with(model: game_detail) do |form| %>
  <% if game_detail.errors.any? %>
    <div style="color: red">
      <h2><%= t("ui.form_errors", count: game_detail.errors.count, resource: t("ui.resources.game_detail")) %></h2>

      <ul>
        <% game_detail.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :game_id, style: "display: block" %>
    <%= form.text_field :game_id %>
  </div>

  <div>
    <%= form.label :played_minute, t("ui.minute"), style: "display: block" %>
    <%= form.number_field :played_minute, min: 0 %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.submit t("ui.save_changes") %>
  </div>
<% end %>
