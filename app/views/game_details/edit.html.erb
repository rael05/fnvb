<main class="container my-4" style="max-width: 760px">
  <%= link_to edit_game_path(@game_detail.game), class: "text-decoration-none" do %>
    <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i>Volver al formulario del partido
  <% end %>

  <section class="mt-3 p-4 border rounded-3 shadow-sm bg-white">
    <p class="text-uppercase small fw-bold text-danger mb-1">Detalles de jugadas</p>
    <h1 class="h3 mb-4">Modificar jugada</h1>

    <% if @game_detail.errors.any? %>
      <div class="alert alert-danger">
        <p class="fw-bold mb-1"><%= pluralize(@game_detail.errors.count, "error") %> impidieron guardar los cambios:</p>
        <ul class="mb-0"><% @game_detail.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <%= form_with model: @game_detail do |form| %>
      <%= form.hidden_field :game_id %>
      <div class="mb-3">
        <%= form.label :team_id, "Equipo", class: "form-label" %>
        <%= form.select :team_id, options_for_select(@team_options, @game_detail.team_id), {}, class: "form-select" %>
      </div>
      <div class="mb-3">
        <%= form.label :player_id, "Jugador", class: "form-label" %>
        <%= form.select :player_id, options_for_select(@player_options, @game_detail.player_id), {}, class: "form-select" %>
      </div>
      <div class="row g-3 mb-3">
        <div class="col-sm-6">
          <%= form.label :detail_type, "Tipo de acción", class: "form-label" %>
          <%= form.select :detail_type, options_for_select(@detail_types, @game_detail.detail_type), {}, class: "form-select" %>
        </div>
        <div class="col-sm-3">
          <%= form.label :number_set, "Set", class: "form-label" %>
          <%= form.number_field :number_set, class: "form-control", min: 1, max: 5 %>
        </div>
        <div class="col-sm-3">
          <%= form.label :order, "Orden", class: "form-label" %>
          <%= form.number_field :order, class: "form-control", min: 1 %>
        </div>
      </div>
      <div class="mb-4">
        <%= form.label :description, "Descripción", class: "form-label" %>
        <%= form.text_area :description, class: "form-control", rows: 3 %>
      </div>
      <div class="d-flex gap-2">
        <%= form.submit "Guardar cambios", class: "btn btn-primary" %>
        <%= link_to "Cancelar", edit_game_path(@game_detail.game), class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </section>
</main>
