<main class="container my-4" style="max-width: 760px">
  <%= link_to edit_game_path(@game_detail.game), class: "text-decoration-none" do %>
    <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i><%= t("ui.back_to_match_form") %>
  <% end %>

  <section class="mt-3 p-4 border rounded-3 shadow-sm bg-white">
    <p class="text-uppercase small fw-bold text-danger mb-1"><%= t("ui.play_details") %></p>
    <h1 class="h3 mb-4"><%= t("ui.edit_play") %></h1>

    <% if @game_detail.errors.any? %>
      <div class="alert alert-danger">
        <p class="fw-bold mb-1"><%= t("ui.form_errors", count: @game_detail.errors.count, resource: t("ui.resources.game_detail")) %></p>
        <ul class="mb-0"><% @game_detail.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <%= form_with model: @game_detail do |form| %>
      <%= form.hidden_field :game_id %>
      <div class="mb-3">
        <%= form.label :team_id, t("team"), class: "form-label" %>
        <%= form.select :team_id, options_for_select(@team_options, @game_detail.team_id), {}, class: "form-select" %>
      </div>
      <div class="mb-3">
        <%= form.label :player_id, t("ui.player_label"), class: "form-label" %>
        <%= form.select :player_id, options_for_select(@player_options, @game_detail.player_id), {}, class: "form-select" %>
      </div>
      <div class="row g-3 mb-3">
        <div class="col-md-5">
          <%= form.label :detail_type, t("ui.action_type"), class: "form-label" %>
          <%= form.select :detail_type, options_for_select(@detail_types, @game_detail.detail_type), {}, class: "form-select" %>
        </div>
        <div class="col-md-2">
          <%= form.label :number_set, t("ui.set"), class: "form-label" %>
          <%= form.number_field :number_set, class: "form-control", min: 1, max: 5 %>
        </div>
        <div class="col-md-2">
          <%= form.label :played_minute, t("ui.minute"), class: "form-label" %>
          <%= form.number_field :played_minute, class: "form-control", min: 0, placeholder: t("ui.example_minute") %>
        </div>
        <div class="col-md-3">
          <%= form.label :order, t("ui.order"), class: "form-label" %>
          <%= form.number_field :order, class: "form-control", min: 1 %>
        </div>
      </div>
      <div class="mb-4">
        <%= form.label :description, t("ui.description"), class: "form-label" %>
        <%= form.text_area :description, class: "form-control", rows: 3 %>
      </div>
      <div class="d-flex gap-2">
        <%= form.submit t("ui.save_changes"), class: "btn btn-primary" %>
        <%= link_to t("ui.cancel"), edit_game_path(@game_detail.game), class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </section>
</main>
