<div id="<%= dom_id game_detail %>">
  <p>
    <strong><%= t("ui.match") %>:</strong>
    <%= game_detail.game_id %>
  </p>

  <p>
    <strong><%= t("ui.minute") %>:</strong>
    <%= game_detail.played_minute.present? ? "#{game_detail.played_minute}′" : t("ui.no_registered") %>
  </p>

  <p>
    <strong><%= t("ui.description") %>:</strong>
    <%= game_detail.description %>
  </p>

</div>
