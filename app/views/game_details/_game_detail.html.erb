<div id="<%= dom_id game_detail %>">
  <p>
    <strong>Game:</strong>
    <%= game_detail.game_id %>
  </p>

  <p>
    <strong>Minuto de juego:</strong>
    <%= game_detail.played_minute.present? ? "#{game_detail.played_minute}′" : "No registrado" %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= game_detail.description %>
  </p>

</div>
