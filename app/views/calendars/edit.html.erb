<% content_for :head do %>
  <%= javascript_import_module_tag "calendar_form" %>
<% end %>

<h1><%= t("ui.edit_resource", resource: t("ui.resources.calendar").capitalize) %></h1>

<%= render "form", calendar: @calendar %>

<br>

<div>
  <%= link_to t("ui.show_resource", resource: t("ui.resources.calendar").capitalize), @calendar %> |
  <section data-turbo="false">
    <%= link_to t("ui.back_to_calendars"), calendars_path %>
  </section>
</div>
