<div id="<%= dom_id calendar %>">
  <p>
    <strong><%= t("ui.team_one") %>:</strong>
    <%= calendar.team1 %>
  </p>

  <p>
    <strong><%= t("ui.team_two") %>:</strong>
    <%= calendar.team2 %>
  </p>

  <p>
    <strong><%= t("ui.description") %>:</strong>
    <%= calendar.description %>
  </p>

  <p>
    <strong><%= t("ui.stage") %>:</strong>
    <%= calendar.stage.present? ? t(Calendar::TYPE_STAGE.key(calendar.stage), default: calendar.stage) : t("ui.no_specification") %>
  </p>

  <p>
    <strong><%= t("ui.date_time") %>:</strong>
    <%= calendar.start_date_time %>
  </p>

  <p>
    <strong><%= t("ui.status") %>:</strong>
    <%= calendar.status.present? ? t(Calendar::TYPE_STATUS.key(calendar.status), default: calendar.status) : t("ui.no_specification") %>
  </p>

</div>
