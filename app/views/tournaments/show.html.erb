<p style="color: green"><%= notice %></p>

<div class="container text-center">
  <div class="row">
    <div class="col-12 col-lg-3 shadow p-3 mb-4 mb-lg-5 bg-body-tertiary rounded">
      <div>
        <p>
          <% if @tournament.image.present? %>
            <%= image_tag @tournament.image, class: "card-img-top border" %>
          <% else %>
            <%= image_tag("tournament_ball.jpg", alt: t("ui.generic_tournament_image"), class: "card-img-top border") %>
          <% end %>
        </p>

        <h4>
          <strong><%= @tournament.name %></strong>
        </h4>

        <p>
          <%= @tournament.description %>
        </p>
      </div>
      <div class="d-flex justify-content-center">
        <%= link_to t("ui.edit"), edit_tournament_path(@tournament), class: "btn btn-outline-success ms-2" %>
        <% if can?(:enable_change, @tournament) %>
          <%= button_to(enable_change_tournament_path(@tournament), method: :patch, class: "btn btn-outline-danger ms-2", form: { data: { turbo: false } }) do %>
            <i class="fa-solid <%= @tournament.enabled? ? 'fa-eye-slash' : 'fa-eye' %> me-2" aria-hidden="true"></i><%= @tournament.enabled? ? t("ui.disable") : t("ui.enable") %>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="col-12 col-lg-9 shadow p-3 mb-4 mb-lg-5 bg-body-tertiary rounded">
      <div class="d-flex align-items-center flex-wrap gap-3 mb-3">
        <h1 class="mb-0">
          <a href="<%= tournaments_path %>" style="text-decoration: none" class="me-3">
            <i class="fa-regular fa-circle-left fa-sm"></i>
          </a><%= @tournament.completed_name %>
        </h1>
        <% colors = { scheduled: "secondary", in_progress: "primary", concluded: "success" } %>
        <span class="badge bg-<%= colors[@tournament.status_key] %>">
          <%= t("tournament_#{@tournament.status_key}") %>
        </span>
        <%= link_to tournament_path(@tournament, format: :pdf), class: "btn btn-outline-danger" do %>
          <i class="fa-solid fa-file-pdf me-2" aria-hidden="true"></i><%= t("ui.download_teams_pdf") %>
        <% end %>
        <%= link_to tournament_path(@tournament, format: :xlsx), class: "btn btn-outline-success" do %>
          <i class="fa-solid fa-file-excel me-2" aria-hidden="true"></i><%= t("ui.download_teams_excel") %>
        <% end %>
        <%= link_to tournament_path(@tournament, format: :pdf, report: :calendar), class: "btn btn-outline-primary" do %>
          <i class="fa-solid fa-calendar-days me-2" aria-hidden="true"></i><%= t("ui.download_match_schedule") %>
        <% end %>
        <%= link_to tournament_path(@tournament, format: :xlsx, report: :calendar), class: "btn btn-outline-success" do %>
          <i class="fa-solid fa-file-excel me-2" aria-hidden="true"></i><%= t("ui.download_match_schedule_excel") %>
        <% end %>
      </div>
      <table class="table table-success table-bordered table-striped">
        <thead>
          <tr>
            <th scope="col"><%= t("ui.number_abbr") %></th>
            <th scope="col"><%= t("team") %></th>
            <th scope="col"><%= t("ui.matches_played_abbr") %></th>
            <th scope="col"><%= t("ui.matches_won_abbr") %></th>
            <th scope="col"><%= t("ui.matches_lost_abbr") %></th>
            <th scope="col"><%= t("ui.points") %></th>
          </tr>
        </thead>
        <tbody>
          <% @standings.each_with_index do |(team, stats), index| %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= link_to team.team_name, team_path(team) %></td>
              <td><%= stats[:played] %></td>
              <td><%= stats[:won] %></td>
              <td><%= stats[:lost] %></td>
              <td><%= stats[:points] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/juegos", tournament: @tournament %>
    </div>
  </div>

  <section class="tournament-gallery mt-2 mt-lg-3">
    <% gallery_albums = can?(:enable_change, Album) ? @tournament.albums : @tournament.albums.where(enabled: true) %>
    <div class="tournament-gallery__heading">
      <div>
        <p class="tournament-gallery__eyebrow mb-1"><%= t("ui.tournament_moments") %></p>
        <h2 class="mb-0"><%= t("ui.photo_gallery") %></h2>
      </div>
      <%= link_to new_album_path(tournament_id: @tournament.id), class: "btn tournament-gallery__add" do %>
        <i class="fa-solid fa-circle-plus me-2" aria-hidden="true"></i><%= t("ui.add_gallery") %>
      <% end %>
    </div>

    <% if gallery_albums.any? %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4 mt-1">
        <% gallery_albums.each do |album| %>
          <div class="col">
            <%= link_to album_path(album), class: "tournament-gallery__card" do %>
              <div class="tournament-gallery__image-wrap">
                <% if album.main_image.attached? %>
                  <%= image_tag album.main_image, class: "tournament-gallery__image", alt: album.name %>
                <% else %>
                  <%= image_tag "tournament_ball.jpg", class: "tournament-gallery__image", alt: t("ui.gallery_without_cover") %>
                <% end %>
                <span class="tournament-gallery__count"><i class="fa-regular fa-images me-1" aria-hidden="true"></i><%= album.images.count %></span>
              </div>
              <div class="tournament-gallery__caption">
                <h3><%= album.name %></h3>
                <span><%= t("ui.view_gallery") %> <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="tournament-gallery__empty">
        <i class="fa-regular fa-images" aria-hidden="true"></i>
        <div><strong><%= t("ui.no_galleries_yet") %></strong><p class="mb-0"><%= t("ui.add_photos_prompt") %></p></div>
      </div>
    <% end %>
  </section>
</div>
