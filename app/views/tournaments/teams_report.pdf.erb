<meta charset="utf-8" />
<style>
  body { color: #24344d; font-family: Arial, sans-serif; font-size: 10pt; }
  h1, h2, h3 { color: #172b4d; }
  h1 { margin-bottom: 4px; text-align: center; }
  .subtitle { color: #6d7a8e; margin: 0 0 22px; text-align: center; }
  .summary { background: #f1f4f8; border-left: 4px solid #c9273b; margin-bottom: 20px; padding: 10px 13px; }
  .team { border: 1px solid #d9e0e9; margin-bottom: 17px; page-break-inside: avoid; }
  .team-heading { background: #172b4d; color: #fff; padding: 9px 12px; }
  .team-heading h2 { color: #fff; display: inline; font-size: 14pt; margin: 0; }
  .team-heading span { float: right; font-size: 9pt; }
  .staff { border-collapse: collapse; margin: 9px 12px; width: calc(100% - 24px); }
  .staff td { padding: 4px 7px; vertical-align: top; width: 50%; }
  .staff strong { color: #52647e; }
</style>

<h1><%= t("ui.federation_brand") %></h1>
<p class="subtitle"><%= t("ui.teams_in_tournament", tournament: @tournament.completed_name) %></p>

<div class="summary">
  <strong><%= t("ui.total_teams") %>:</strong> <%= @teams.size %>
  &nbsp; | &nbsp;
  <strong><%= t("ui.generation_date") %>:</strong> <%= l(Time.current, format: :long) %>
</div>

<% if @teams.any? %>
  <% @teams.each_with_index do |team, index| %>
    <section class="team">
      <div class="team-heading">
        <h2><%= index + 1 %>. <%= team.team_name %></h2>
        <span><%= team.enabled? ? t("ui.enabled") : t("ui.disabled") %></span>
      </div>

      <table class="staff">
        <tr>
          <td><strong><%= t("delegate_name") %>:</strong> <%= [team.delegate_name, team.delegate_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></td>
          <td><strong><%= t("ui.head_coach") %>:</strong> <%= [team.head_coach_name, team.head_coach_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></td>
        </tr>
        <tr>
          <td><strong><%= t("ui.assistant_coach") %>:</strong> <%= [team.assistant_coach1_name, team.assistant_coach1_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></td>
          <td><strong><%= t("ui.second_assistant") %>:</strong> <%= [team.assistant_coach2_name, team.assistant_coach2_last_name].compact_blank.join(" ").presence || t("ui.no_assignment") %></td>
        </tr>
        <tr>
          <td><strong><%= t("ui.uniform") %> 1:</strong> <%= [team.color_shirt1, team.color_short1].compact_blank.join(" · ").presence || t("ui.no_specification") %></td>
          <td><strong><%= t("ui.uniform") %> 2:</strong> <%= [team.color_shirt2, team.color_short2].compact_blank.join(" · ").presence || t("ui.no_specification") %></td>
        </tr>
      </table>

    </section>
  <% end %>
<% else %>
  <p><%= t("ui.no_teams_in_tournament") %></p>
<% end %>
