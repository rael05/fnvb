<div>
    <h3><%= t("ui.tournament_schedule", tournament: tournament.truncate_name) %></h3>

    <div class="accordion accordion-flush border" id="accordionFlushExample">
        <% tournament.calendars.each_with_index do | calendar, index | %>
            <% game = calendar.games.first %>
            <div class="accordion-item">
            <div class="d-flex align-items-center">
            <h2 class="accordion-header flex-grow-1 mb-0">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>" aria-expanded="false" aria-controls="flush-collapseOne">
                <strong>
                    <%= calendar.teamDetail1.team_name %>
                    vs
                    <%= calendar.teamDetail2.team_name %>
                    &nbsp;
                </strong>
                <% if calendar.start_date_time.present? %>
                    <%= I18n.l(calendar.start_date_time, format: :long) %>
                <% else %>
                    <span class="badge text-bg-warning ms-2"><%= t("ui.no_date_assigned") %></span>
                <% end %>
                </button>
            </h2>
            <%= link_to t(calendar.start_date_time.present? ? "ui.edit_match_date" : "ui.assign_match_date"), edit_calendar_path(calendar), class: "btn btn-outline-primary btn-sm mx-2 flex-shrink-0" %>
            </div>
            <div id="collapse<%= index %>" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
                <div class="accordion-body">
                    <% if calendar.start_date_time.blank? %>
                        <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 mb-0" role="status">
                            <span><%= t("ui.assign_match_date_first") %></span>
                        </div>
                    <% elsif game.nil? %>
                        <%= link_to t("ui.register_match"), new_game_path(calendar_id: calendar.id), class: "btn btn-success me-2" %>
                    <% else %>
                        <%= link_to t("ui.enter_match_details"), edit_game_path(game), class: "btn btn-primary me-2" %>
                    <% end %>
                </div>
            </div>
            </div>
        <% end %>
    </div>
    <% if tournament.calendars.count == 0 %>
        <h6 class="mt-3"><%= t("ui.no_matches_scheduled", tournament: tournament.name) %></h6>
    <% end %>
</div>
