<div class="px-3 py-2 border rounded-3">
  <%= form_with(model: player) do |form| %>
    <% if player.errors.any? %>
      <div style="color: red">
        <h2><%= t("ui.form_errors", count: player.errors.count, resource: t("ui.resources.player")) %></h2>

        <ul>
          <% player.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3 row">
      <div class="col">
        <%= form.label :name, class: "form-label" %>
        <%= form.text_field :name, class: "form-control" %>
      </div>
      <div class="col">
        <%= form.label :last_name, class: "form-label" %>
        <%= form.text_field :last_name, class: "form-control" %>
      </div>
    </div>

    <div class="mb-3 row">
      <div class="col">
        <%= form.label :position, class: "form-label" %>
        <%= form.select :position, @positions, { prompt: t("ui.select_position") }, class: "form-select" %>
      </div>
      <div class="col">
        <%= form.label :number, class: "form-label" %>
        <%= form.number_field :number, class: "form-control" %>
      </div>
    </div>

    <div class="mb-3 row">
      <div class="col">
        <%= form.label :birthday, class: "form-label" %>
        <%= form.date_field :birthday, class: "form-control" %>
      </div>
      <div class="col">
        <%= form.label :gender, class: "form-label" %>
        <%= form.select :gender, @genders, { prompt: t("ui.select_gender") }, class: "form-select" %>
      </div>
    </div>

    <div class="mb-3 row">
      <div class="col">
        <%= form.label :weight, class: "form-label" %>
        <%= form.number_field :weight, class: "form-control" %>
      </div>
      <div class="col">
        <%= form.label :height, class: "form-label" %>
        <%= form.number_field :height, class: "form-control" %>
      </div>
    </div>

    <div class="mb-3">
      <%= form.label :team_id, t("ui.player_team_field"), class: "form-label" %>
      <fieldset disabled>
        <%= form.text_field :team_id, value: current_user.team.team_name, class: "form-control" %>
      </fieldset>
    </div>

    <div class="mb-3">
      <%= form.label :nationality, class: "form-label" %>
      <%= form.text_field :nationality, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :image, t("ui.upload_player_photo"), class: "form-label" %>
      <%= form.file_field :image, class: "form-control" %>
    </div>

    <div>
      <%= form.submit class: "btn btn-primary mb-2" %>
    </div>
  <% end %>
</div>
