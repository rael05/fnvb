<meta charset="utf-8" />
<style>
  body { color: #26364f; font-family: Arial, sans-serif; font-size: 9.5pt; }
  h1, h2, h3 { color: #172b4d; }
  .header { border-bottom: 3px solid #c9273b; margin-bottom: 20px; padding-bottom: 13px; }
  .brand { color: #172b4d; font-size: 10pt; font-weight: bold; letter-spacing: 1px; text-align: center; text-transform: uppercase; }
  .report-title { margin: 13px 0 4px; text-align: center; }
  .player-name { font-size: 24pt; font-weight: bold; }
  .generated { color: #748198; font-size: 8.5pt; text-align: center; }
  .summary { background: #f1f4f8; border-left: 4px solid #c9273b; margin-bottom: 18px; padding: 10px 13px; }
  .number { color: #c9273b; font-weight: bold; }
  .section-title { border-bottom: 1px solid #dfe5ed; font-size: 12pt; margin: 18px 0 9px; padding-bottom: 6px; }
  .facts { border-collapse: collapse; width: 100%; }
  .facts td { border: 1px solid #e2e7ee; padding: 8px 10px; vertical-align: top; width: 50%; }
  .facts tr:nth-child(odd) td { background: #f7f9fc; }
  .label { color: #718096; display: block; font-size: 7.5pt; font-weight: bold; letter-spacing: .4px; margin-bottom: 3px; text-transform: uppercase; }
  .value { color: #26364f; font-size: 9pt; }
  .team-card { background: #172b4d; color: #fff; margin-top: 12px; padding: 12px 14px; }
  .team-card .label { color: #c5d0df; }
  .team-card h3 { color: #fff; font-size: 15pt; margin: 0 0 5px; }
  .team-card p { margin: 3px 0; }
  .tournaments { color: #52647e; line-height: 1.6; }
  .stats-summary { background: #f1f4f8; border-left: 4px solid #18764b; margin-bottom: 9px; padding: 9px 12px; }
  .stats { border-collapse: collapse; width: 100%; }
  .stats th, .stats td { border: 1px solid #dfe5ed; padding: 6px 8px; text-align: left; }
  .stats th { background: #172b4d; color: #fff; font-size: 8pt; }
  .stats td:last-child, .stats th:last-child { text-align: center; width: 20%; }
  .stats tbody tr:nth-child(even) { background: #f5f7fa; }
  .stats tfoot { background: #eef2f7; font-weight: bold; }
  .matches { border-collapse: collapse; width: 100%; }
  .matches thead { display: table-header-group; }
  .matches th, .matches td { border: 1px solid #dfe5ed; padding: 6px 7px; text-align: left; }
  .matches th { background: #172b4d; color: #fff; font-size: 8pt; }
  .matches tbody tr:nth-child(even) { background: #f5f7fa; }
  .matches tr { page-break-inside: avoid; }
  .empty { background: #f7f9fc; color: #748198; padding: 12px; }
  .footer { border-top: 1px solid #dfe5ed; color: #8994a5; font-size: 8pt; margin-top: 20px; padding-top: 8px; text-align: center; }
</style>

<div class="header">
  <div class="brand">FNVB · Federación Nicaragüense de Voleibol</div>
  <div class="report-title">
    <div class="label">Ficha del jugador</div>
    <div class="player-name"><%= [@player.name, @player.last_name].compact_blank.join(" ") %></div>
  </div>
  <div class="generated">Reporte generado el <%= l(Time.current, format: :long) %></div>
</div>

<div class="summary">
  <span class="number">Camiseta #<%= @player.number.presence || "—" %></span>
  &nbsp; · &nbsp; <%= Player::POSITION_HASH[@player.position.to_s.to_sym] || @player.position || "Posición no especificada" %>
  &nbsp; · &nbsp; <%= @player.enabled? ? "Jugador habilitado" : "Jugador deshabilitado" %>
</div>

<h2 class="section-title">Datos personales y físicos</h2>
<table class="facts">
  <tr>
    <td><span class="label">Fecha de nacimiento</span><span class="value"><%= @player.birthday.present? ? l(@player.birthday, format: :long) : "No registrada" %></span></td>
    <td><span class="label">Género</span><span class="value"><%= Player::GENDER_HASH[@player.gender.to_s.to_sym] || "No especificado" %></span></td>
  </tr>
  <tr>
    <td><span class="label">Altura</span><span class="value"><%= @player.height.present? ? "#{@player.height} m" : "No registrada" %></span></td>
    <td><span class="label">Peso</span><span class="value"><%= @player.weight.present? ? "#{@player.weight} kg" : "No registrado" %></span></td>
  </tr>
  <tr>
    <td colspan="2"><span class="label">Nacionalidad</span><span class="value"><%= @player.nationality.presence || "No registrada" %></span></td>
  </tr>
</table>

<h2 class="section-title">Equipo</h2>
<div class="team-card">
  <span class="label">Equipo actual</span>
  <h3><%= @team.team_name %></h3>
  <p><strong>Entrenador:</strong> <%= [@team.head_coach_name, @team.head_coach_last_name].compact_blank.join(" ").presence || "Sin asignar" %></p>
  <p><strong>Jugadores en la plantilla:</strong> <%= @team.players.size %></p>
</div>
<p class="tournaments">
  <strong>Torneos recientes:</strong>
  <%= @team_tournaments.map(&:completed_name).presence&.join(" · ") || "Sin torneos registrados" %>
</p>

<h2 class="section-title">Estadísticas de partidos</h2>
<div class="stats-summary">
  <strong><%= @registered_action_count %></strong> acciones registradas en
  <strong><%= @matches_with_recorded_actions %></strong> partidos finalizados.
</div>
<p class="generated">Conteo de acciones asociadas al jugador en Game Details; no representa porcentajes de efectividad.</p>
<table class="stats">
  <thead><tr><th>Tipo de acción</th><th>Acciones registradas</th></tr></thead>
  <tbody>
    <% GameDetail::DETAIL_TYPE_HASH.each do |code, label| %>
      <tr>
        <td><%= label %></td>
        <td><%= @game_detail_counts.fetch(code.to_s, 0) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot><tr><td>Total</td><td><%= @registered_action_count %></td></tr></tfoot>
</table>

<h2 class="section-title">Partidos recientes del equipo</h2>
<% if @recent_games.any? %>
  <table class="matches">
    <thead><tr><th>Fecha</th><th>Torneo</th><th>Encuentro</th><th>Resultado</th><th>Resultado del equipo</th></tr></thead>
    <tbody>
      <% @recent_games.each do |game| %>
        <% calendar = game.calendar %>
        <% winner = [calendar.team_one, calendar.team_two].compact.find { |team| team.id == game.winning_team } %>
        <% loser = [calendar.team_one, calendar.team_two].compact.find { |team| team.id == game.lose_team } %>
        <% team_won = game.winning_team == @team.id %>
        <tr>
          <td><%= calendar.start_date_time.present? ? l(calendar.start_date_time, format: :short) : "—" %></td>
          <td><%= calendar.tournament.name %></td>
          <td><%= winner&.team_name || "Equipo ganador" %> vs. <%= loser&.team_name || "Equipo rival" %></td>
          <td><%= game.win_score.presence || "—" %> : <%= game.lose_score.presence || "—" %></td>
          <td><%= team_won ? "Victoria" : "Derrota" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty">Aún no hay partidos finalizados registrados para este equipo.</div>
<% end %>

<div class="footer">Federación Nicaragüense de Voleibol · FNVB</div>
