<p style="color: green"><%= notice %></p>

<div class="shadow p-3 rounded-3">
  <h1 class="text-center border-bottom pb-2">
    <%= t(:players) %>
    <a href="<%= new_player_path %>" style="text-decoration: none" class="ms-3">
      <i class="fa-solid fa-circle-plus fa-xs"></i>
    </a>
  </h1>

  <!-- Formulario de búsqueda -->
  <div class="text-center mt-3">
    <%= form_with url: players_path, method: :get, local: true, class: "d-inline-block w-100", style: "max-width: 850px" do |form| %>
      <div class="input-group">
        <%= form.text_field :search, value: params[:search], placeholder: t(:search_by_name), class: "form-control" %>
        <%= form.select :team_id,
                        options_for_select([[t("ui.all_teams"), ""]] + @teams.map { |team| [team.team_name, team.id] }, @selected_team_id),
                        {},
                        class: "form-select",
                        aria: { label: t("ui.filter_players_by_team") } %>
        <button type="submit" class="btn btn-outline-primary">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <span class="visually-hidden"><%= t("ui.filter") %></span>
        </button>
      </div>
    <% end %>
  </div>

  <!-- Contenedor de jugadores -->
  <div id="players" class="mt-2 row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
    <% @players.each_with_index do |player, index| %>
      <div class="col">
        <div class="card <%= "bg-black bg-opacity-25" unless player.enabled %>">
          <a href="<%= player_path(player) %>" class="border-bottom py-2">
            <% if player.image.present? %>
              <%= image_tag player.image, class: 'card-img-top', style: player.enabled ? '' : 'opacity: 0.3;' %>
            <% else %>
              <% if player.gender == "F" %>
                <%= image_tag("default_female.png", alt: t("ui.default_image_alt"), class: 'card-img-top', style: player.enabled ? '' : 'opacity: 0.3;') %>
              <% else %>
                <%= image_tag("default_male.png", alt: t("ui.default_image_alt"), class: 'card-img-top', style: player.enabled ? '' : 'opacity: 0.3;') %>
              <% end %>
            <% end %>
          </a>
          <div class="card-body">
            <h4 class="card-title">
              <a href="<%= player_path(player) %>" class="link-dark" style="text-decoration: none">
                <%= "#{player.name} #{player.last_name}".truncate(50) %>
              </a>
            </h4>
            <strong style="font-size: 15px;"><%= t(:team) %></strong>
            <p class="card-text">
              <%= player.team.team_name %>
            </p>
            <strong style="font-size: 15px;"><%= t("ui.position") %>:</strong>
            <p class="card-text">
              <%= t("ui.positions.#{player.position}") %>
            </p>
          </div>
          <div class="card-footer">
            <small class="text-body-secondary">
              <div class="row ms-0 mt-1">
                <div class="border rounded-circle position-relative bg-white" style="width: 30px; height: 30px">
                  <a href="<%= edit_player_path(player) %>" style="text-decoration: none" class="link-success position-absolute top-50 start-50 translate-middle">
                    <i class="fa-solid fa-pen"></i>
                  </a>
                </div>
                <div class="border rounded-circle position-relative bg-white ms-1" style="width: 30px; height: 30px">
                  <!-- Botón para abrir el modal -->
                  <a href="#" data-bs-toggle="modal" data-bs-target="#modal-<%= index %>" style="text-decoration: none" class="link-danger position-absolute top-50 start-50 translate-middle">
                    <i class="fa-solid <%= player.enabled ? 'fa-eye-slash' : 'fa-eye' %>"></i>
                  </a>
                </div>
              </div>
            </small>
          </div>
        </div>
      </div>

      <!-- Modal para cambiar enabled -->
      <div class="modal fade" id="modal-<%= index %>" tabindex="-1" aria-labelledby="modalLabel-<%= index %>" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="modalLabel-<%= index %>">
                <%= t(player.enabled? ? "ui.confirm_disable_player" : "ui.confirm_enable_player") %>
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('ui.close') %>"></button>
            </div>
            <div class="modal-body">
              <%= t(player.enabled? ? "ui.confirm_disable_player" : "ui.confirm_enable_player") %>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("ui.cancel") %></button>
              <% if can?(:enable_change, player) %>
                <%= button_to(enable_change_player_path(player), method: :patch, class: "btn btn-danger", form: { data: { turbo: false } }) do %>
                  <i class="fa-solid <%= player.enabled? ? 'fa-eye-slash' : 'fa-eye' %> me-2" aria-hidden="true"></i><%= player.enabled? ? t("ui.disable") : t("ui.enable") %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <nav class="mt-4" aria-label="<%= t('ui.pagination_players') %>">
      <ul class="pagination justify-content-center mb-0">
        <li class="page-item <%= 'disabled' if @current_page == 1 %>">
          <%= link_to t("ui.previous"), players_path(page: @current_page - 1, search: params[:search], team_id: @selected_team_id), class: 'page-link', aria: { label: t("ui.previous") } %>
        </li>
        <% (1..@total_pages).each do |page| %>
          <li class="page-item <%= 'active' if page == @current_page %>">
          <%= link_to page, players_path(page: page, search: params[:search], team_id: @selected_team_id), class: 'page-link', aria: { current: (page == @current_page ? 'page' : nil) } %>
          </li>
        <% end %>
        <li class="page-item <%= 'disabled' if @current_page == @total_pages %>">
          <%= link_to t("ui.next"), players_path(page: @current_page + 1, search: params[:search], team_id: @selected_team_id), class: 'page-link', aria: { label: t("ui.next") } %>
        </li>
      </ul>
    </nav>
  <% end %>
</div>
