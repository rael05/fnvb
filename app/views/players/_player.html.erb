<div id="<%= dom_id player %>">
  <p>
    <strong><%= t("ui.number") %>:</strong>
    <%= player.number %>
  </p>

  <p>
    <strong><%= t(:name) %>:</strong>
    <%= player.name %>
  </p>

  <p>
    <strong><%= t(:last_name) %>:</strong>
    <%= player.last_name %>
  </p>

  <p>
    <strong><%= t("ui.position") %>:</strong>
    <%= player.position.present? ? t("ui.positions.#{player.position}") : "—" %>
  </p>

  <p>
    <strong><%= t("ui.birth_date") %>:</strong>
    <%= player.birthday %>
  </p>

  <p>
    <strong><%= t("ui.gender") %>:</strong>
    <%= player.gender.present? ? t("ui.genders.#{player.gender}") : "—" %>
  </p>

  <p>
    <strong><%= t("ui.weight") %>:</strong>
    <%= player.weight %>
  </p>

  <p>
    <strong><%= t("ui.height") %>:</strong>
    <%= player.height %>
  </p>

  <p>
    <strong><%= t("team") %>:</strong>
    <%= player.team.team_name %>
  </p>

  <p>
    <strong><%= t("ui.nationality") %>:</strong>
    <%= player.nationality %>
  </p>

</div>
